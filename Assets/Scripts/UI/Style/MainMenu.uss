:root {
}

.holder {
    align-items: center;
    margin-top: auto;
    margin-right: auto;
    margin-bottom: auto;
    margin-left: auto;
}



.title {
    margin-bottom: 20px;
    font-size: 60px;
    -unity-font-style: bold;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(255, 255, 255);
    color: rgb(51, 51, 51);
    -unity-font-definition: url("project://database/Assets/Art/Font/MidnightSpree-Regular.ttf?fileID=12800000&guid=655f0f26f981e11458be2fe61262c730&type=3#MidnightSpree-Regular");
}

.fade-out {
    transition-property: opacity;
    transition-duration: 1s;
    opacity: 0;
}

.black-out {
    transition-property: color;
    transition-duration: 4s;
    color: rgb(255, 0, 0);
    background-color: rgb(0, 0, 0);
}

.logo {
    background-image: url("project://database/Assets/Art/Textures/Transparent.png?fileID=2800000&guid=1ed71eed84c173a47a6dde8d42cbcc6e&type=3#Transparent");
    width: 200px;
    height: 200px;
    position: absolute;
    top: -78px;
}
