:root {
    background-color: rgb(23, 22, 29);
}

.content-holder {
    align-self: center;
    margin-top: auto;
    margin-bottom: auto;
    align-items: center;
    flex-direction: column;
}

.title {
    color: rgb(180, 180, 180);
    -unity-text-outline-color: rgb(0, 0, 0);
    -unity-text-outline-width: 1px;
    font-size: 65px;
}

.button {
    width: 400px;
    height: 70px;
    font-size: 37px;
}
