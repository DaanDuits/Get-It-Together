:root {
    -unity-font-definition: url("project://database/Assets/Art/Font/MidnightSpree-Regular.ttf?fileID=12800000&guid=655f0f26f981e11458be2fe61262c730&type=3#MidnightSpree-Regular");
}

.content-holder {
    align-self: center;
    margin-top: auto;
    margin-bottom: auto;
    align-items: center;
    flex-direction: column;
}

.title {
    color: rgb(35, 35, 35);
    -unity-text-outline-color: rgb(228, 228, 228);
    -unity-text-outline-width: 1px;
    font-size: 43px;
    -unity-font-style: bold;
}

.button {
    width: 400px;
    height: 70px;
    font-size: 37px;
}
